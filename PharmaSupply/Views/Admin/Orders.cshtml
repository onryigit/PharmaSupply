@model IReadOnlyList<Order>
@{ ViewData["Title"] = "Sipariş Takibi"; }
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-main"><header class="admin-top"><div><span class="eyebrow">OPERASYON</span><h1>Sipariş takibi</h1><p>Siparişlerin hazırlanma ve teslimat durumlarını yönetin.</p></div></header><section class="admin-card"><div class="table-wrap"><table><thead><tr><th>Sipariş</th><th>Eczane</th><th>Ürün</th><th>Tutar</th><th>Tarih</th><th>Durum</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><b>#PS-@item.Id.ToString("D4")</b></td><td>@item.Pharmacy?.Name</td><td>@item.Items.Sum(x => x.Quantity) kutu</td><td><b>@item.Total.ToString("N2") ₺</b></td><td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td><td><form asp-action="UpdateOrder" method="post" class="status-form"><input type="hidden" name="id" value="@item.Id"/><select name="status" onchange="this.form.submit()" asp-for="@item.Status" asp-items="Html.GetEnumSelectList<OrderStatus>()"></select></form></td></tr>}</tbody></table></div></section></div></div>
