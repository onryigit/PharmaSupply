@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "İlaç Yönetimi";
}

<div class="admin-shell">
    <partial name="_AdminNav" />
    <div class="admin-main">
        <header class="admin-top">
            <div>
                <span class="eyebrow">KATALOG</span>
                <h1>İlaç yönetimi</h1>
                <p>@Model.Count kayıtlı ürün</p>
            </div>
            <a class="btn primary" asp-action="ProductForm">
                <span class="material-symbols-rounded">add</span>Yeni ilaç
            </a>
        </header>
        <section class="admin-card">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th>Etken madde</th>
                            <th>Reçete</th>
                            <th>Stok</th>
                            <th>Fiyat</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="table-product">
                                        <img src="@item.ImageUrl" alt="@item.Name" />
                                        <div>
                                            <b>@item.Name</b>
                                            <small>@item.Category?.Name</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.ActiveIngredient</td>
                                <td><span class="status">@item.PrescriptionType</span></td>
                                <td><b class="@(item.Stock < 50 ? "text-danger" : "")">@item.Stock</b></td>
                                <td>@item.UnitPrice.ToString("N2") ₺</td>
                                <td class="actions">
                                    <a asp-action="ProductForm" asp-route-id="@item.Id">
                                        <span class="material-symbols-rounded">edit</span>
                                    </a>
                                    <form asp-action="DeleteProduct" method="post"
                                          onsubmit="return confirm('Ürün silinsin mi?')">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button><span class="material-symbols-rounded">delete</span></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
