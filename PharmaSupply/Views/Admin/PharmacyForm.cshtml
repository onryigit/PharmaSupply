@model Pharmacy
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni Eczane" : "Eczane Düzenle";
}

<div class="admin-shell">
    <partial name="_AdminNav" />
    <div class="admin-main narrow">
        <header class="admin-top">
            <div>
                <a class="back" asp-action="Pharmacies">← Eczanelere dön</a>
                <h1>@ViewData["Title"]</h1>
                <p>Ticari ve lisans bilgilerini yönetin.</p>
            </div>
        </header>
        <form asp-action="PharmacyForm" method="post" class="admin-card form-card">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <div class="form-grid">
                <label>Eczane adı<input asp-for="Name" /><span asp-validation-for="Name"></span></label>
                <label>Lisans numarası<input asp-for="LicenseNumber" /><span asp-validation-for="LicenseNumber"></span></label>
                <label>Cari bakiye<input asp-for="Balance" type="number" step=".01" /></label>
                <label>Kredi limiti<input asp-for="CreditLimit" type="number" step=".01" /></label>
                <label>Aylık kırmızı reçete kotası<input asp-for="MonthlyRedPrescriptionQuota" type="number" /></label>
                <label>Kullanılan kota<input asp-for="UsedRedPrescriptionQuota" type="number" /></label>
                <label class="check wide">
                    <input asp-for="IsLicenseActive" />
                    <span>Lisans aktif ve doğrulanmış</span>
                </label>
            </div>
            <div class="form-actions">
                <a class="btn ghost" asp-action="Pharmacies">Vazgeç</a>
                <button class="btn primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>
