@model Product
@{ ViewData["Title"] = Model.Id == 0 ? "Yeni İlaç" : "İlaç Düzenle"; var categories = ViewBag.Categories as IReadOnlyList<Category> ?? []; }
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-main narrow"><header class="admin-top"><div><a class="back" asp-action="Products">← İlaçlara dön</a><h1>@ViewData["Title"]</h1><p>Ürün ve tedarik bilgilerini eksiksiz girin.</p></div></header><form asp-action="ProductForm" method="post" class="admin-card form-card"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label>Ürün adı<input asp-for="Name"/><span asp-validation-for="Name"></span></label><label>Etken madde<input asp-for="ActiveIngredient"/><span asp-validation-for="ActiveIngredient"></span></label><label>Kategori<select asp-for="CategoryId">@foreach(var c in categories){<option value="@c.Id">@c.Name</option>}</select></label><label>Ürün tipi<select asp-for="Kind" asp-items="Html.GetEnumSelectList<ProductKind>()"></select></label><label>Reçete tipi<select asp-for="PrescriptionType" asp-items="Html.GetEnumSelectList<PrescriptionType>()"></select></label><label>Birim fiyat<input asp-for="UnitPrice" type="number" step=".01"/></label><label>Stok<input asp-for="Stock" type="number"/></label><label>Son kullanma tarihi<input asp-for="ExpirationDate" type="date"/></label><label class="wide">Görsel URL<input asp-for="ImageUrl" type="url"/></label><label class="wide">Açıklama<textarea asp-for="Description" rows="5"></textarea></label><label class="check wide"><input asp-for="IsBestSeller"/><span>Çok satanlarda göster</span></label></div><div class="form-actions"><a class="btn ghost" asp-action="Products">Vazgeç</a><button class="btn primary">Kaydet</button></div></form></div></div>
