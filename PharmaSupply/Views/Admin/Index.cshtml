@model DashboardViewModel
@{ ViewData["Title"] = "Yönetim Paneli"; }
<div class="admin-shell"><partial name="_AdminNav"/><div class="admin-main"><header class="admin-top"><div><span class="eyebrow">10 AĞUSTOS 2026</span><h1>İyi akşamlar, Yönetici</h1><p>PharmaSupply operasyonlarının güncel özeti.</p></div><a class="btn primary" asp-action="ProductForm"><span class="material-symbols-rounded">add</span>Yeni ilaç</a></header><div class="stats"><div><span class="stat-icon blue material-symbols-rounded">medication</span><small>Toplam ürün</small><b>@Model.ProductCount</b><em>Aktif katalog</em></div><div><span class="stat-icon green material-symbols-rounded">storefront</span><small>Kayıtlı eczane</small><b>@Model.PharmacyCount</b><em>Doğrulanmış hesap</em></div><div><span class="stat-icon orange material-symbols-rounded">local_shipping</span><small>Açık sipariş</small><b>@Model.OpenOrderCount</b><em>İşlem bekliyor</em></div><div><span class="stat-icon purple material-symbols-rounded">payments</span><small>Aylık ciro</small><b>@Model.MonthlyRevenue.ToString("N0") ₺</b><em>Bu ay</em></div></div>
<div class="admin-columns"><section class="admin-card"><div class="card-head"><div><h2>Son siparişler</h2><p>En güncel eczane siparişleri</p></div><a asp-action="Orders">Tümünü gör</a></div><div class="table-wrap"><table><thead><tr><th>Sipariş</th><th>Eczane</th><th>Tutar</th><th>Durum</th></tr></thead><tbody>@foreach(var order in Model.LatestOrders){<tr><td><b>#PS-@order.Id.ToString("D4")</b><small>@order.CreatedAt.ToString("dd MMM HH:mm")</small></td><td>@order.Pharmacy?.Name</td><td><b>@order.Total.ToString("N2") ₺</b></td><td><span class="status @order.Status.ToString().ToLowerInvariant()">@order.Status</span></td></tr>}</tbody></table></div></section><section class="admin-card alerts"><div class="card-head"><div><h2>Akıllı uyarılar</h2><p>Stok ve miat gözlemcisi</p></div><span class="notification-count">@Model.Notifications.Count</span></div>@if(Model.Notifications.Count == 0){<div class="empty small"><span class="material-symbols-rounded">notifications_none</span><p>Yeni uyarı yok.</p></div>}@foreach(var note in Model.Notifications){<div class="alert-item"><span class="material-symbols-rounded">warning</span><div><b>Operasyon uyarısı</b><p>@note.Message</p><small>@note.CreatedAt.ToString("dd MMM HH:mm")</small></div></div>}</section></div></div></div>
