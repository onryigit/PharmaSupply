@model ShopViewModel
@{
    ViewData["Title"] = "Ürün Kataloğu";
}

<section class="page-heading">
    <div class="container">
        <span class="eyebrow">MEDİKAL KATALOG</span>
        <h1>Ürünler</h1>
        <p>İhtiyacınız olan ürünü profesyonel filtrelerle hızla bulun.</p>
    </div>
</section>

<div class="container shop-layout">
    <aside class="filters">
        <div class="filter-title">
            <h3>Filtreler</h3>
            <a asp-action="Index">Temizle</a>
        </div>
        <form method="get">
            <input type="hidden" name="q" value="@Model.Filter.Search" />
            <input type="hidden" name="sort" value="@Model.Filter.Sort" />
            <label>Etken madde</label>
            <select name="ingredient">
                <option value="">Tümü</option>
                @foreach (var item in Model.Ingredients)
                {
                    <option value="@item" selected="@(Model.Filter.Ingredient == item)">@item</option>
                }
            </select>
            <label>Reçete tipi</label>
            @foreach (var type in Enum.GetValues<PrescriptionType>())
            {
                <label class="check">
                    <input type="radio" name="prescription" value="@type"
                           checked="@(Model.Filter.Prescription == type)" />
                    <span>@(type == PrescriptionType.Normal ? "Normal Reçete" : type == PrescriptionType.Red ? "Kırmızı Reçete" : "Yeşil Reçete")</span>
                </label>
            }
            <label>Stok durumu</label>
            <label class="check">
                <input type="checkbox" name="inStock" value="true"
                       checked="@(Model.Filter.InStock == true)" />
                <span>Yalnızca stoktakiler</span>
            </label>
            <button class="btn primary full">Filtreleri uygula</button>
        </form>
    </aside>

    <section class="catalog">
        <div class="catalog-top">
            <p>
                <b>@Model.Products.Count</b> ürün listeleniyor
                @if (!string.IsNullOrWhiteSpace(Model.Filter.Search))
                {
                    <span>· “@Model.Filter.Search” araması</span>
                }
            </p>
            <form method="get">
                <input type="hidden" name="q" value="@Model.Filter.Search" />
                <input type="hidden" name="ingredient" value="@Model.Filter.Ingredient" />
                <input type="hidden" name="prescription" value="@Model.Filter.Prescription" />
                <input type="hidden" name="inStock" value="@Model.Filter.InStock" />
                <input type="hidden" name="categoryId" value="@Model.Filter.CategoryId" />
                <select name="sort" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Filter.Sort))">Önerilen sıralama</option>
                    <option value="priceAsc" selected="@(Model.Filter.Sort == "priceAsc")">Fiyat: Artan</option>
                </select>
            </form>
        </div>
        <div class="products-grid">
            @foreach (var item in Model.Products)
            {
                <partial name="_ProductCard" model="item" />
            }
        </div>
        @if (Model.Products.Count == 0)
        {
            <div class="empty">
                <span class="material-symbols-rounded">search_off</span>
                <h3>Ürün bulunamadı</h3>
                <p>Arama veya filtrelerinizi değiştirerek yeniden deneyin.</p>
            </div>
        }
    </section>
</div>
