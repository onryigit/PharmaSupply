@model Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="container detail-page">
    <div class="breadcrumb">
        <a asp-action="Index">Ürünler</a><span>/</span>
        <span>@Model.Category?.Name</span><span>/</span><b>@Model.Name</b>
    </div>
    <div class="detail-grid">
        <div class="detail-image">
            <img src="@Model.ImageUrl" alt="@Model.Name" />
            <span class="image-seal material-symbols-rounded">verified</span>
        </div>
        <div class="detail-content">
            <span class="badge blue">@Model.Category?.Name</span>
            <h1>@Model.Name</h1>
            <p class="ingredient">Etken madde: <b>@Model.ActiveIngredient</b></p>
            <div class="info-chips">
                <span><i class="material-symbols-rounded">inventory_2</i><small>Stok</small><b>@Model.Stock kutu</b></span>
                <span><i class="material-symbols-rounded">prescriptions</i><small>Reçete</small><b>@Model.PrescriptionType</b></span>
                <span><i class="material-symbols-rounded">event</i><small>Son kullanım</small><b>@Model.ExpirationDate.ToString("MM/yyyy")</b></span>
            </div>
            <p class="description">@Model.Description</p>
            <div class="price">
                <small>Eczane satış fiyatı</small>
                <strong>@Model.UnitPrice.ToString("N2") ₺</strong>
                <span>KDV hariç liste fiyatıdır</span>
            </div>
            <form asp-controller="Cart" asp-action="Add" method="post" class="add-form">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" />
                <button class="btn primary" disabled="@(Model.Stock == 0)">
                    <span class="material-symbols-rounded">shopping_bag</span> Sepete ekle
                </button>
            </form>
            <div class="detail-note">
                <span class="material-symbols-rounded">local_shipping</span>
                15:00'a kadar verilen siparişler aynı gün sevk edilir.
            </div>
        </div>
    </div>
</div>
